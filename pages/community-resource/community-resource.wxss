@import "../community-shared/community-shared.wxss";

.resource-layout { min-height: 0; flex: none; display: flex; flex-direction: row; overflow: hidden; }
.category-nav { width: 176rpx; flex: none; min-height: 0; background: #eef4e5; }
.category-item { min-height: 104rpx; padding: 24rpx 18rpx; display: flex; align-items: center; color: #69766d; font-size: 23rpx; line-height: 1.45; box-sizing: border-box; }
.category-item-active { position: relative; color: #3f6635; background: #fbf8ec; font-weight: 700; }
.category-item-active::before { position: absolute; top: 24rpx; bottom: 24rpx; left: 0; width: 7rpx; border-radius: 0 7rpx 7rpx 0; background: #8dbd59; content: ""; }
.resource-pane { flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; padding: 26rpx 24rpx 0; box-sizing: border-box; }
.resource-heading { flex: none; display: block; margin-bottom: 20rpx; color: #435348; font-size: 28rpx; font-weight: 750; }
.state-card { min-height: 330rpx; padding: 34rpx 26rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid rgba(93,121,79,.14); border-radius: 24rpx; background: #fffefa; text-align: center; box-sizing: border-box; }
.state-symbol { width: 74rpx; height: 74rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #668f42; background: #edf5df; font-size: 42rpx; }
.state-title { display: block; margin-top: 22rpx; font-size: 27rpx; font-weight: 700; line-height: 1.45; }
.state-description { display: block; margin-top: 12rpx; color: #7b877f; font-size: 22rpx; line-height: 1.65; word-break: break-all; }
.retry-button { min-height: 68rpx; margin-top: 24rpx; padding: 0 32rpx; border-radius: 999rpx; color: #35562b; background: #dff3b7; font-size: 23rpx; }
.retry-button::after { border: 0; }
.resource-list { width: 100%; min-width: 0; min-height: 0; flex: 1; box-sizing: border-box; }
.resource-card + .resource-card { margin-top: 18rpx; }
.resource-list-safe-area { height: calc(38rpx + env(safe-area-inset-bottom)); }
.resource-card { overflow: hidden; border: 1rpx solid rgba(93,121,79,.14); border-radius: 22rpx; background: #fffefa; box-shadow: 0 10rpx 26rpx rgba(72,91,61,.07); }
.resource-image-frame { position: relative; width: 100%; height: 0; padding-top: 56.25%; background: #e6ebe0; overflow: hidden; }
.resource-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.resource-body { padding: 22rpx; }
.resource-name { display: block; font-size: 28rpx; font-weight: 750; line-height: 1.4; word-break: break-all; }
.resource-meta, .resource-description, .resource-tag-line { display: block; margin-top: 9rpx; color: #6f7d73; font-size: 21rpx; line-height: 1.55; word-break: break-all; }
.verification-badge { display: inline-flex; margin-top: 12rpx; padding: 5rpx 12rpx; border-radius: 999rpx; color: #805e29; background: #fff1cf; font-size: 19rpx; }
.verification-badge-verified { color: #3f6635; background: #e5f3d2; }
@media (max-width: 340px) { .category-nav { width: 146rpx; } .category-item { padding-right: 12rpx; padding-left: 12rpx; font-size: 21rpx; } .resource-pane { padding-right: 16rpx; padding-left: 16rpx; } }
