page { height: 100vh; min-height: 0; display: flex; flex-direction: column; overflow: hidden; color: #28362d; background: #fbf8ec; }
navigation-bar { flex: none; }
.community-scroll { height: 100%; }
.community-page { min-height: 100%; padding: 32rpx 28rpx calc(124rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.bottom-navigation { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; padding: 10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(93,121,79,.12); background: #dff3b7; box-shadow: 0 -8rpx 24rpx rgba(72,91,61,.06); }
.bottom-navigation-item { min-height: 70rpx; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #74816f; font-size: 21rpx; line-height: 30rpx; }
.nav-icon { width: 28rpx; height: 28rpx; flex: none; margin-bottom: 2rpx; }
.bottom-navigation-item-active { color: #466b34; font-weight: 700; }
@media (max-width: 340px) { .community-page { padding-right: 20rpx; padding-left: 20rpx; } }
