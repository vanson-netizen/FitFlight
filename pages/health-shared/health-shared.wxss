page { height: 100vh; display: flex; flex-direction: column; color: #28362d; background: #fbf8ec; font-size: 28rpx; }
.health-scroll { min-height: 0; flex: 1; }
.health-page { width: 100%; max-width: 720rpx; min-height: 100%; margin: 0 auto; padding: 30rpx 38rpx calc(44rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; }
.title { font-size: 34rpx; font-weight: 700; }
.primary-button, .secondary-button, .retry-button { margin: 0; border-radius: 18rpx; font-size: 23rpx; font-weight: 600; }
.primary-button { padding: 0 25rpx; color: #263820; background: #a8d96f; line-height: 66rpx; }
.secondary-button, .retry-button { padding: 0 22rpx; color: #668f42; background: #eaf6d5; line-height: 56rpx; }
.primary-button::after, .secondary-button::after, .retry-button::after { border: 0; }
.card, .state-card { border: 1rpx solid rgba(93,121,79,.14); border-radius: 24rpx; background: #fffefa; box-shadow: 0 10rpx 28rpx rgba(72,91,61,.07); box-sizing: border-box; }
.state-card { min-height: 330rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; padding: 36rpx; color: #7c887f; text-align: center; }
.state-title { color: #28362d; font-size: 28rpx; font-weight: 700; }
.state-copy { line-height: 1.55; }
.loading-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #a8d96f; }
.section-title { display: block; margin: 28rpx 0 16rpx; font-size: 27rpx; font-weight: 700; }
.disclaimer { display: block; margin-top: 24rpx; color: #8b968e; font-size: 20rpx; line-height: 1.55; }
@media (max-width: 340px) { .health-page { padding-right: 28rpx; padding-left: 28rpx; } }
