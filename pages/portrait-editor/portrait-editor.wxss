page { height: 100vh; color: #28362d; background: #fbf8ec; }
.scrollarea { height: 100%; }
.page {
  min-height: 100%;
  padding: 36rpx 32rpx calc(64rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.state-card, .form-card { width: 100%; max-width: 720rpx; margin: 0 auto; padding: 40rpx 34rpx; border: 1rpx solid rgba(93,121,79,.14); border-radius: 28rpx; background: #fffefa; box-sizing: border-box; box-shadow: 0 12rpx 34rpx rgba(72,91,61,.08); }
.state-card { min-height: 360rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.loading-dot { width: 18rpx; height: 18rpx; margin-bottom: 20rpx; border-radius: 50%; background: #a8d96f; }
.state-title, .title { display: block; font-size: 36rpx; font-weight: 700; }
.description, .hint { display: block; margin-top: 12rpx; color: #748078; font-size: 24rpx; line-height: 1.6; }
.field { margin-top: 30rpx; }
.label { display: block; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 600; }
.picker-value { min-height: 76rpx; padding: 0 24rpx; display: flex; align-items: center; border-radius: 18rpx; background: #f4f7ec; color: #526159; font-size: 26rpx; }
.check-option { min-height: 64rpx; display: flex; align-items: center; gap: 14rpx; font-size: 25rpx; }
.field-error, .form-error { display: block; margin-top: 10rpx; color: #b6534d; font-size: 23rpx; }
.safety-hint { display: block; margin-top: 24rpx; padding: 20rpx; border-radius: 18rpx; color: #735d36; background: #fff3d8; font-size: 24rpx; line-height: 1.6; }
.submit-button, .secondary-action { border-radius: 999rpx; color: #35562b; background: #dff3b7; font-weight: 600; }
.submit-button { margin-top: 34rpx; }
.secondary-action { margin-top: 26rpx; padding: 0 36rpx; font-size: 26rpx; }
.submit-button::after, .secondary-action::after { border: 0; }
