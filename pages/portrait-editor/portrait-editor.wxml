<navigation-bar title="完善画像" back="{{true}}" color="#25352b" background="#dff3b7"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view wx:if="{{loadStatus === 'loading'}}" class="state-card"><view class="loading-dot"></view><text>正在读取画像…</text></view>
    <view wx:elif="{{loadStatus === 'error'}}" class="state-card"><text class="state-title">画像读取失败</text><text class="hint">{{errorMessage}}</text><button class="secondary-action" bindtap="loadPortrait">重试</button></view>
    <view wx:elif="{{loadStatus === 'incomplete'}}" class="state-card"><text class="state-title">请先完善身体信息</text><button class="secondary-action" bindtap="openBodyProfile">去完善</button></view>
    <view wx:else class="form-card">
      <text class="title">{{portraitVersion ? '更新我的画像' : '生成我的初始画像'}}</text>
      <text class="description">请根据自己的目标和实际训练条件主动选择。</text>

      <view class="field"><text class="label">所在校区</text><picker range="{{campusOptions}}" range-key="label" value="{{indices.campus}}" data-field="campus" data-options="campusOptions" data-index="campus" bindchange="changeSingleOption"><view class="picker-value">{{indices.campus >= 0 ? campusOptions[indices.campus].label : '请选择'}}</view></picker><text wx:if="{{fieldErrors.campus}}" class="field-error">{{fieldErrors.campus}}</text></view>
      <view class="field"><text class="label">训练目标</text><picker range="{{trainingGoalOptions}}" range-key="label" value="{{indices.trainingGoal}}" data-field="trainingGoal" data-options="trainingGoalOptions" data-index="trainingGoal" bindchange="changeSingleOption"><view class="picker-value">{{indices.trainingGoal >= 0 ? trainingGoalOptions[indices.trainingGoal].label : '请选择'}}</view></picker><text wx:if="{{fieldErrors.trainingGoal}}" class="field-error">{{fieldErrors.trainingGoal}}</text></view>
      <view class="field"><text class="label">每周可训练天数</text><picker range="{{availableDaysOptions}}" range-key="label" value="{{indices.availableDays}}" data-field="availableDaysPerWeek" data-options="availableDaysOptions" data-index="availableDays" bindchange="changeSingleOption"><view class="picker-value">{{indices.availableDays >= 0 ? availableDaysOptions[indices.availableDays].label : '请选择'}}</view></picker><text wx:if="{{fieldErrors.availableDaysPerWeek}}" class="field-error">{{fieldErrors.availableDaysPerWeek}}</text></view>
      <view class="field"><text class="label">单次可训练时间</text><picker range="{{sessionDurationOptions}}" range-key="label" value="{{indices.sessionDuration}}" data-field="sessionDurationMinutes" data-options="sessionDurationOptions" data-index="sessionDuration" bindchange="changeSingleOption"><view class="picker-value">{{indices.sessionDuration >= 0 ? sessionDurationOptions[indices.sessionDuration].label : '请选择'}}</view></picker><text wx:if="{{fieldErrors.sessionDurationMinutes}}" class="field-error">{{fieldErrors.sessionDurationMinutes}}</text></view>
      <view class="field"><text class="label">训练经验</text><picker range="{{experienceLevelOptions}}" range-key="label" value="{{indices.experienceLevel}}" data-field="experienceLevel" data-options="experienceLevelOptions" data-index="experienceLevel" bindchange="changeSingleOption"><view class="picker-value">{{indices.experienceLevel >= 0 ? experienceLevelOptions[indices.experienceLevel].label : '请选择'}}</view></picker><text wx:if="{{fieldErrors.experienceLevel}}" class="field-error">{{fieldErrors.experienceLevel}}</text></view>
      <view class="field"><text class="label">器械条件</text><picker range="{{equipmentAccessOptions}}" range-key="label" value="{{indices.equipmentAccess}}" data-field="equipmentAccess" data-options="equipmentAccessOptions" data-index="equipmentAccess" bindchange="changeSingleOption"><view class="picker-value">{{indices.equipmentAccess >= 0 ? equipmentAccessOptions[indices.equipmentAccess].label : '请选择'}}</view></picker><text wx:if="{{fieldErrors.equipmentAccess}}" class="field-error">{{fieldErrors.equipmentAccess}}</text></view>

      <view class="field"><text class="label">运动偏好（可多选）</text><checkbox-group bindchange="changePreferences"><label wx:for="{{exercisePreferenceOptions}}" wx:key="value" class="check-option"><checkbox value="{{item.value}}" checked="{{item.checked}}" color="#75a94f"></checkbox><text>{{item.label}}</text></label></checkbox-group><text wx:if="{{fieldErrors.exercisePreferences}}" class="field-error">{{fieldErrors.exercisePreferences}}</text></view>

      <view class="field"><text class="label">运动限制情况</text><picker range="{{exerciseLimitationOptions}}" range-key="label" value="{{indices.exerciseLimitation}}" data-field="exerciseLimitationStatus" data-options="exerciseLimitationOptions" data-index="exerciseLimitation" bindchange="changeSingleOption"><view class="picker-value">{{indices.exerciseLimitation >= 0 ? exerciseLimitationOptions[indices.exerciseLimitation].label : '请选择'}}</view></picker><text wx:if="{{fieldErrors.exerciseLimitationStatus}}" class="field-error">{{fieldErrors.exerciseLimitationStatus}}</text></view>
      <text wx:if="{{form.exerciseLimitationStatus === 'unsure' || form.exerciseLimitationStatus === 'has_limitation'}}" class="safety-hint">生成或执行运动方案前，建议根据自身情况咨询医生或专业人士。</text>
      <text wx:if="{{errorMessage}}" class="form-error">{{errorMessage}}</text>
      <button class="submit-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="submit">{{isSubmitting ? '生成中…' : '保存并生成画像'}}</button>
    </view>
  </view>
</scroll-view>
