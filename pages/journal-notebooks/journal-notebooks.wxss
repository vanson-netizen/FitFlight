@import "../journal-shared/journal-shared.wxss";
.notebook-card { min-width: 0; display: flex; align-items: center; padding: 26rpx 24rpx; }
.notebook-main { min-width: 0; flex: 1; }
.notebook-title, .notebook-meta { display: block; }
.notebook-title { overflow: hidden; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.notebook-meta { margin-top: 8rpx; color: #7c887f; font-size: 20rpx; }
.rename-button { flex: none; margin: 0 6rpx 0 14rpx; padding: 0 16rpx; border-radius: 14rpx; color: #668f42; background: #eaf6d5; font-size: 20rpx; line-height: 48rpx; }
.rename-button::after { border: 0; }
.card-arrow { flex: none; color: #9aa59c; font-size: 38rpx; }
