page { background: #f4f7ef; color: #25352b; }
.scrollarea { height: 100vh; }
.page {
  box-sizing: border-box;
  min-height: 100%;
  padding: 32rpx 28rpx calc(64rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card, .state-card { padding: 40rpx 32rpx; border-radius: 28rpx; background: #fff; }
.state-card { min-height: 360rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #718078; text-align: center; }
.loading-dot { width: 20rpx; height: 20rpx; margin-bottom: 22rpx; border-radius: 50%; background: #a8d96f; }
.state-title { color: #25352b; font-size: 32rpx; font-weight: 700; }
.state-description { margin-top: 14rpx; font-size: 25rpx; line-height: 1.6; }
.retry-button { margin-top: 30rpx; padding: 0 36rpx; border-radius: 999rpx; color: #25352b; background: #dff3b7; font-size: 27rpx; }
.retry-button::after { border: 0; }
.title { display: block; font-size: 42rpx; font-weight: 700; }
.description { display: block; margin: 14rpx 0 36rpx; color: #718078; font-size: 26rpx; line-height: 1.6; }
.field { margin-top: 28rpx; }
.label { display: block; margin-bottom: 12rpx; font-size: 27rpx; font-weight: 600; }
.input, .picker-value { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 24rpx; border: 2rpx solid #d9e1d8; border-radius: 16rpx; background: #fbfcf9; font-size: 30rpx; line-height: 84rpx; }
.placeholder { color: #9ba69f; }
.field-error { display: block; margin-top: 8rpx; color: #c43d32; font-size: 24rpx; }
.error-message { display: block; margin-top: 28rpx; color: #c43d32; font-size: 26rpx; }
.submit-button { margin-top: 38rpx; border-radius: 999rpx; background: #25352b; color: #fff; font-size: 30rpx; font-weight: 600; }
.submit-button[disabled] { background: #829087; color: #eef2ed; }
