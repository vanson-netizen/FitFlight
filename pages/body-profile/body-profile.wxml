<navigation-bar title="身体信息" back="{{true}}" color="#25352b" background="#dff3b7"></navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view wx:if="{{loadStatus === 'loading'}}" class="state-card">
      <view class="loading-dot"></view>
      <text>正在读取身体档案</text>
    </view>

    <view wx:elif="{{loadStatus === 'error'}}" class="state-card">
      <text class="state-title">暂时无法读取身体档案</text>
      <text class="state-description">{{errorMessage}}</text>
      <button class="retry-button" bindtap="retryLoad">重新加载</button>
    </view>

    <view wx:else class="card">
      <text class="title">{{hasExistingProfile ? '查看与修改身体信息' : '完善身体信息'}}</text>
      <text class="description">这些信息只会保存到当前微信用户的云端资料中。</text>

      <view class="field">
        <text class="label">性别</text>
        <picker range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="changeGender">
          <view class="picker-value {{form.gender ? '' : 'placeholder'}}">{{form.gender ? genderOptions[genderIndex].label : '请选择'}}</view>
        </picker>
        <text wx:if="{{fieldErrors.gender}}" class="field-error">{{fieldErrors.gender}}</text>
      </view>

      <view class="field">
        <text class="label">出生日期</text>
        <picker mode="date" end="{{today}}" value="{{form.birthDate}}" bindchange="changeBirthDate">
          <view class="picker-value {{form.birthDate ? '' : 'placeholder'}}">{{form.birthDate || '请选择'}}</view>
        </picker>
        <text wx:if="{{fieldErrors.birthDate}}" class="field-error">{{fieldErrors.birthDate}}</text>
      </view>

      <view class="field">
        <text class="label">身高（cm）</text>
        <input class="input" type="digit" value="{{form.heightCm}}" data-field="heightCm" bindinput="changeNumber" placeholder="80–250" />
        <text wx:if="{{fieldErrors.heightCm}}" class="field-error">{{fieldErrors.heightCm}}</text>
      </view>

      <view class="field">
        <text class="label">当前体重（kg）</text>
        <input class="input" type="digit" value="{{form.weightKg}}" data-field="weightKg" bindinput="changeNumber" placeholder="20–400" />
        <text wx:if="{{fieldErrors.weightKg}}" class="field-error">{{fieldErrors.weightKg}}</text>
      </view>

      <view class="field">
        <text class="label">目标体重（kg）</text>
        <input class="input" type="digit" value="{{form.targetWeightKg}}" data-field="targetWeightKg" bindinput="changeNumber" placeholder="选填，20–400" />
        <text wx:if="{{fieldErrors.targetWeightKg}}" class="field-error">{{fieldErrors.targetWeightKg}}</text>
      </view>

      <view class="field">
        <text class="label">日常活动水平</text>
        <picker range="{{activityOptions}}" range-key="label" value="{{activityIndex}}" bindchange="changeActivity">
          <view class="picker-value {{form.activityLevel ? '' : 'placeholder'}}">{{form.activityLevel ? activityOptions[activityIndex].label : '请选择'}}</view>
        </picker>
        <text wx:if="{{fieldErrors.activityLevel}}" class="field-error">{{fieldErrors.activityLevel}}</text>
      </view>

      <text wx:if="{{errorMessage}}" class="error-message" role="alert">{{errorMessage}}</text>
      <button class="submit-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="submit">
        {{isSubmitting ? '保存中…' : (hasExistingProfile ? '保存修改' : '保存身体信息')}}
      </button>
    </view>
  </view>
</scroll-view>

<portrait-onboarding
  visible="{{showPortraitOnboarding}}"
  loading="{{isOpeningPortraitEditor}}"
  bindconfirm="openPortraitEditor"
  binddismiss="skipPortraitOnboarding"
></portrait-onboarding>
