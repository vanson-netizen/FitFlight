<navigation-bar main-page="{{true}}" back="{{false}}" color="#25352b" background="#dff3b7"></navigation-bar>

<scroll-view class="community-scroll" style="{{homeScrollHeight === null ? '' : 'height: ' + homeScrollHeight + 'px; flex: none;'}}" scroll-y="{{true}}" type="list">
  <view class="community-page community-home" style="{{homeContentHeight === null ? '' : 'height: ' + homeContentHeight + 'px;'}}">
    <view class="community-heading">
      <text class="community-eyebrow">FitFlight 社区</text>
      <text class="community-title">发现适合你的校园生活资源</text>
      <text class="community-description">资源信息将在完成核实后逐步开放。</text>
    </view>

    <view class="entry-list">
      <view wx:for="{{entries}}" wx:key="id" class="entry-card {{item.themeClass}}" role="button" aria-label="{{item.title}}，{{item.description}}" data-route="{{item.route}}" bindtap="openCategory" hover-class="entry-card-hover">
        <image wx:if="{{!item.imageHidden}}" class="entry-image" style="{{item.imageStyle}}" src="{{item.backgroundImage}}" mode="aspectFill" data-id="{{item.id}}" data-src="{{item.backgroundImage}}" binderror="onImageError"></image>
        <view class="entry-overlay"></view>
        <view class="entry-content"><text class="entry-title">{{item.title}}</text><text class="entry-description">{{item.description}}</text></view>
        <text class="entry-arrow">›</text>
      </view>
    </view>
  </view>
</scroll-view>

<view class="bottom-navigation">
  <view class="bottom-navigation-item" role="button" bindtap="openFifi"><image class="nav-icon" src="/assets/icons/tab-fifi-inactive.png" mode="aspectFit"></image><text>FIFI</text></view>
  <view class="bottom-navigation-item" role="button" bindtap="openCultivation"><image class="nav-icon" src="/assets/icons/tab-cultivation-inactive.png" mode="aspectFit"></image><text>培养</text></view>
  <view class="bottom-navigation-item bottom-navigation-item-active"><image class="nav-icon" src="/assets/icons/tab-community-active.png" mode="aspectFit"></image><text>社区</text></view>
  <view class="bottom-navigation-item" role="button" bindtap="openMine"><image class="nav-icon" src="/assets/icons/tab-mine-inactive.png" mode="aspectFit"></image><text>我的</text></view>
</view>
