page { height:100vh; display:flex; flex-direction:column; color:#28362d; background:#fbf8ec; font-size:28rpx; }
.settings-scroll { min-height:0; flex:1; }
.settings-page { width:100%; max-width:720rpx; min-height:100%; margin:0 auto; padding:44rpx 34rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.section-label { display:block; margin:14rpx 8rpx 14rpx; color:#668f42; font-size:23rpx; font-weight:700; }
.list-card { overflow:hidden; border:1rpx solid rgba(93,121,79,.14); border-radius:22rpx; background:#fffefa; box-shadow:0 8rpx 24rpx rgba(72,91,61,.06); }
.list-item { min-height:92rpx; display:flex; align-items:center; padding:0 26rpx; border-bottom:1rpx solid rgba(93,121,79,.12); box-sizing:border-box; }
.list-item:last-child { border-bottom:0; }
.item-value { min-width:0; margin-left:auto; padding-left:20rpx; color:#89948c; font-size:25rpx; text-align:right; }
.error-message { display:block; margin:22rpx 8rpx 0; color:#ae4c52; font-size:22rpx; line-height:1.5; }
.content-card { padding:28rpx; border:1rpx solid rgba(93,121,79,.14); border-radius:22rpx; background:#fffefa; box-sizing:border-box; }
.content-title { display:block; margin-bottom:14rpx; font-size:30rpx; font-weight:700; }
.content-section { margin-top:28rpx; }
.content-section:first-child { margin-top:0; }
.content-heading { display:block; margin-bottom:10rpx; color:#466b34; font-size:25rpx; font-weight:700; }
.content-copy { display:block; color:#5f6d64; font-size:23rpx; line-height:1.75; }
@media (max-width:340px) { .settings-page { padding-right:26rpx; padding-left:26rpx; } }
