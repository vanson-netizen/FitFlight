@import "../health-shared/health-shared.wxss";
.selector { display:flex; gap:12rpx; margin-bottom:16rpx; }
.selector-item { min-width:0; flex:1; padding:15rpx 8rpx; border-radius:999rpx; color:#69766d; background:#edf1e8; font-size:21rpx; text-align:center; }
.selector-active { color:#35562b; background:#dff3b7; font-weight:700; }
.chart-card { padding:26rpx; }
.chart-heading { display:flex; justify-content:space-between; gap:14rpx; font-size:25rpx; font-weight:700; }
.chart-heading text:last-child { color:#668f42; font-size:21rpx; }
.insufficient { min-height:300rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12rpx; color:#7c887f; font-size:21rpx; text-align:center; }
.trend-canvas { width:100%; height:360rpx; margin-top:20rpx; }
.energy-chart { height:330rpx; display:flex; align-items:flex-end; gap:12rpx; margin-top:24rpx; overflow-x:auto; }
.energy-column { width:70rpx; flex:none; display:flex; flex-direction:column; align-items:center; color:#7c887f; font-size:17rpx; }
.energy-track { width:30rpx; height:220rpx; display:flex; align-items:flex-end; margin-bottom:8rpx; border-radius:999rpx; background:#edf1e8; overflow:hidden; }
.energy-bar { width:100%; border-radius:999rpx; background:#8dbd59; }
