<navigation-bar title="我的成就" color="#25352b" background="#dff3b7"></navigation-bar>

<scroll-view class="achievement-scroll" scroll-y="{{true}}" enhanced="{{true}}" type="list">
  <view class="achievement-page">
    <view wx:if="{{pageStatus === 'loading'}}" class="state-card">
      <view class="loading-dot"></view><text>正在读取成就…</text>
    </view>
    <view wx:elif="{{pageStatus === 'error'}}" class="state-card">
      <text class="state-title">成就读取失败</text>
      <text class="state-copy">{{errorMessage}}</text>
      <button class="retry-button" bindtap="retryLoad">重试</button>
    </view>
    <block wx:elif="{{pageStatus === 'empty' || pageStatus === 'ready'}}">
      <view class="summary-card">
        <text class="summary-label">已解锁</text>
        <view class="summary-value"><text>{{unlockedCount}}</text><text class="summary-total"> / {{totalCount}}</text></view>
        <text class="summary-copy">每一次坚持，都会留下成长的印记。</text>
      </view>
      <text wx:if="{{pageStatus === 'empty'}}" class="empty-note">完成任意一项培养任务，即可解锁第一个成就。</text>
      <view class="achievement-grid">
        <view wx:for="{{achievements}}" wx:key="key" class="achievement-card {{item.unlocked ? '' : 'achievement-card-locked'}}" role="button" data-key="{{item.key}}" bindtap="selectAchievement">
          <view class="grid-icon" aria-hidden="true"><view class="achievement-check"></view></view>
          <text class="grid-name">{{item.name}}</text>
          <text class="grid-status">{{item.unlocked ? '已解锁' : '未解锁'}}</text>
        </view>
      </view>
      <view wx:if="{{selectedAchievement}}" class="detail-card">
        <view class="detail-heading"><view class="detail-icon {{selectedAchievement.unlocked ? '' : 'detail-icon-locked'}}" aria-hidden="true"><view class="achievement-check"></view></view><view><text class="detail-name">{{selectedAchievement.name}}</text><text class="detail-status">{{selectedAchievement.unlocked ? '已解锁' : '尚未解锁'}}</text></view></view>
        <view class="detail-row"><text>解锁条件</text><text>{{selectedAchievement.condition}}</text></view>
        <view wx:if="{{selectedAchievement.unlocked}}" class="detail-row"><text>解锁日期</text><text>{{selectedAchievement.achievedAt}}</text></view>
      </view>
    </block>
  </view>
</scroll-view>
