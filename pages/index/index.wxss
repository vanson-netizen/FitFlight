/** index.wxss：页面级视觉变量，避免影响其他页面。 **/
page {
  --brand: #a8d96f;
  --brand-deep: #668f42;
  --brand-soft: #eaf6d5;
  --header-bg: #dff3b7;
  --page-bg: #fbf8ec;
  --surface: #fffefa;
  --surface-muted: #f4f7ec;
  --text-primary: #28362d;
  --text-secondary: #7c887f;
  --border: rgba(93, 121, 79, .14);
  --shadow: 0 12rpx 34rpx rgba(72, 91, 61, .08);
  --card-radius: 28rpx;
  --page-gutter: 40rpx;
  --card-gap: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  color: var(--text-primary);
  background: var(--page-bg);
  font-size: 28rpx;
}

.scrollarea { min-height: 0; flex: 1; overflow: hidden; }
.scrollarea-editing { overflow-y: auto; }
.page { height: 100%; min-height: 0; padding: 0 var(--page-gutter); box-sizing: border-box; }
.state-panel, .profile-card, .home-panel { width: 100%; max-width: 720rpx; margin: 0 auto; box-sizing: border-box; }
.home-panel { height: 100%; }
.layout-spacer { width: 100%; }
.layout-spacer-top { height: 6%; }
.layout-spacer-profile-progress { height: 3.5%; }
.layout-spacer-progress-entry { height: 2.5%; }
.state-panel { min-height: 420rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; color: var(--text-secondary); }
.loading-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--brand); }

.profile-card, .user-card, .progress-card, .menu-card {
  border: 1rpx solid var(--border);
  border-radius: var(--card-radius);
  background: var(--surface);
  box-shadow: var(--shadow);
  box-sizing: border-box;
}

/* 资料编辑态沿用现有交互，仅同步本页视觉。 */
.profile-card { padding: 48rpx 40rpx 40rpx; }
.card-heading { display: flex; flex-direction: column; margin-bottom: 40rpx; }
.eyebrow { margin-bottom: 12rpx; color: var(--brand-deep); font-size: 24rpx; font-weight: 600; }
.title { margin-bottom: 16rpx; font-size: 44rpx; font-weight: 700; }
.description, .avatar-hint { color: var(--text-secondary); font-size: 26rpx; line-height: 1.6; }
button.avatar-button { width: 168rpx; min-width: 168rpx; max-width: 168rpx; height: 168rpx; margin: 0 auto; padding: 0; overflow: hidden; border: 2rpx dashed #aec794; border-radius: 24rpx; background: var(--surface-muted); box-sizing: border-box; line-height: normal; }
.avatar-button::after, .primary-button::after, .secondary-button::after, .edit-button::after, .body-profile-action::after { border: 0; }
.avatar, .home-avatar { width: 100%; height: 100%; border-radius: 24rpx; }
.avatar { display: block; }
.avatar-placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--brand-deep); font-size: 24rpx; line-height: 1.3; }
.avatar-plus { font-size: 46rpx; font-weight: 300; }
.avatar-hint { display: block; margin: 16rpx 0 38rpx; text-align: center; }
.field-label { display: block; margin-bottom: 14rpx; font-size: 28rpx; font-weight: 600; }
.nickname-input { height: 92rpx; padding: 0 28rpx; border: 1rpx solid var(--border); border-radius: 20rpx; background: var(--surface-muted); font-size: 30rpx; box-sizing: border-box; }
.error-message { display: block; margin-top: 20rpx; color: #b94a52; font-size: 25rpx; }
.primary-button, .secondary-button { height: 92rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; line-height: 92rpx; }
.primary-button { margin-top: 36rpx; color: #23321f; background: var(--brand); }
.secondary-button { margin-top: 16rpx; color: var(--text-primary); background: var(--brand-soft); }

/* 主资料卡：用伪元素形成轻量切角，不依赖绝对定位还原整体布局。 */
.user-card { position: relative; height: 25%; min-height: 0; padding: 34rpx 32rpx 28rpx; overflow: hidden; }
.user-card::before, .user-card::after { position: absolute; width: 52rpx; height: 52rpx; background: var(--page-bg); content: ''; transform: rotate(45deg); }
.user-card::before { top: -30rpx; right: -30rpx; }
.user-card::after { bottom: -30rpx; left: -30rpx; }
.user-row { position: relative; z-index: 1; display: flex; align-items: center; }
.home-avatar { flex: none; width: 104rpx; height: 104rpx; margin-right: 22rpx; background: var(--brand-soft); }
.user-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.welcome { overflow: hidden; font-size: 32rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.profile-meta { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.profile-meta-item { padding: 5rpx 13rpx; border-radius: 999rpx; color: var(--text-secondary); background: var(--surface-muted); font-size: 20rpx; }
.profile-meta-item-accent { color: var(--brand-deep); background: var(--brand-soft); }
.edit-button { flex: none; margin: 0 0 0 14rpx; padding: 0 20rpx; color: var(--brand-deep); background: var(--brand-soft); border-radius: 16rpx; font-size: 22rpx; line-height: 54rpx; }
.body-profile-tip { position: relative; z-index: 1; display: flex; align-items: center; margin-top: 24rpx; padding: 18rpx 22rpx; border: 1rpx solid rgba(102, 143, 66, .12); border-radius: 18rpx; background: #f8f5e8; }
.body-profile-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.body-profile-title { color: #89713f; font-size: 24rpx; font-weight: 600; }
.body-profile-description { margin-top: 2rpx; color: var(--text-secondary); font-size: 19rpx; }
.continue-link { flex: none; margin-left: 16rpx; color: #89713f; font-size: 24rpx; font-weight: 600; }
.body-profile-state { min-height: 64rpx; }
.body-profile-loading-dot { width: 14rpx; height: 14rpx; margin-right: 14rpx; border-radius: 50%; background: var(--brand); }
.body-profile-action { flex: none; margin: 0 0 0 14rpx; padding: 0 18rpx; border-radius: 14rpx; color: #6f5b2f; background: #eee8d0; font-size: 21rpx; line-height: 48rpx; }
.body-profile-motivation { position: relative; z-index: 1; display: flex; flex-direction: column; margin-top: 20rpx; padding: 18rpx 22rpx; border: 1rpx solid rgba(102, 143, 66, .12); border-radius: 18rpx; background: #f8f5e8; box-sizing: border-box; }
.body-profile-complete-label { color: #89713f; font-size: 20rpx; font-weight: 600; }
.body-profile-motivation-text { margin-top: 5rpx; padding-right: 38rpx; color: var(--text-primary); font-size: 22rpx; line-height: 1.45; }

.art-placeholder { border: 1rpx dashed rgba(102, 143, 66, .28); background: var(--brand-soft); box-sizing: border-box; }
.ufo-placeholder, .dog-placeholder { position: absolute; z-index: 0; opacity: .72; }
.ufo-placeholder { top: 18rpx; left: 18rpx; width: 42rpx; height: 30rpx; border-radius: 14rpx; }
.dog-placeholder { right: 14rpx; bottom: 12rpx; width: 44rpx; height: 44rpx; border-radius: 14rpx; }

.progress-card { height: 26%; padding: 20rpx 32rpx 26rpx; overflow: hidden; }
.progress-heading, .progress-label-row { display: flex; align-items: center; justify-content: space-between; }
.section-title, .achievement-title { font-size: 27rpx; font-weight: 700; }
.progress-days { color: var(--text-secondary); font-size: 23rpx; }
.progress-days-value, .progress-value { color: var(--brand-deep); font-weight: 600; }
.progress-label-row { margin-top: 14rpx; color: var(--text-secondary); font-size: 21rpx; }
.progress-track { height: 12rpx; margin-top: 8rpx; overflow: hidden; border-radius: 999rpx; background: #edf0e8; }
.progress-fill { width: 36%; height: 100%; border-radius: inherit; background: var(--brand); }
.data-block-list { display: flex; gap: 18rpx; margin-top: 16rpx; }
.data-block { min-width: 0; height: 60rpx; flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: var(--surface-muted); }
.data-placeholder { width: 56%; height: 12rpx; border-radius: 999rpx; background: #dfe7d8; }
.achievement-area { margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx solid var(--border); }
.achievement-list { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 8rpx; }
.achievement-item { min-width: 0; flex: 1; display: flex; flex-direction: column; align-items: center; color: var(--text-secondary); font-size: 20rpx; text-align: center; }
.achievement-placeholder { width: 40rpx; height: 40rpx; margin-bottom: 4rpx; border: 1rpx dashed rgba(102, 143, 66, .36); border-radius: 12rpx; background: var(--brand-soft); box-sizing: border-box; }

.entry-list { height: 24%; display: flex; flex-direction: column; justify-content: space-between; }
.menu-card { width: 100%; padding: 0 28rpx; }
.menu-card-single { height: 29%; }
.menu-card-single + .menu-card-single { margin-top: 0; }
.menu-item { height: 100%; min-height: 0; display: flex; align-items: center; }
.entry-icon-placeholder { width: 42rpx; height: 42rpx; flex: none; margin-right: 20rpx; border-radius: 13rpx; }
.menu-title { flex: 1; font-size: 27rpx; font-weight: 600; }
.menu-arrow { color: #9aa59c; font-size: 40rpx; font-weight: 300; }
.settings-card { margin-bottom: 12rpx; }

.bottom-navigation { flex: none; display: flex; padding: 10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(93, 121, 79, .12); background: var(--header-bg); box-shadow: 0 -8rpx 24rpx rgba(72, 91, 61, .06); }
.bottom-navigation-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #74816f; font-size: 21rpx; line-height: 32rpx; text-align: center; }
.nav-icon-placeholder { width: 32rpx; height: 32rpx; margin-bottom: 2rpx; border-radius: 10rpx; background: rgba(255, 255, 255, .5); }
.bottom-navigation-item-active { color: #466b34; font-weight: 700; }
.bottom-navigation-item-active .nav-icon-placeholder { border-color: var(--brand-deep); background: var(--brand); }

@media (max-width: 340px) {
  page { --page-gutter: 28rpx; }
  .user-card, .progress-card { padding-right: 28rpx; padding-left: 28rpx; }
  .home-avatar { width: 100rpx; height: 100rpx; margin-right: 18rpx; }
  .edit-button { margin-left: 10rpx; padding: 0 16rpx; }
}
