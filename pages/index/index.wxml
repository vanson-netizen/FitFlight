<!-- index.wxml -->
<navigation-bar title="FitFlight" back="{{false}}" color="#25352b" background="#dff3b7"></navigation-bar>

<scroll-view class="scrollarea {{isEditing ? 'scrollarea-editing' : ''}}" scroll-y="{{isEditing}}" type="list">
  <view class="page page-content">
    <view wx:if="{{isLoading}}" class="state-panel">
      <view class="loading-dot"></view>
      <text>正在读取用户资料</text>
    </view>

    <view wx:elif="{{isEditing}}" class="profile-card edit-profile-card">
      <view class="card-heading">
        <text class="eyebrow">欢迎使用 FitFlight</text>
        <text class="title">{{userProfile ? '重新设置资料' : '登记你的资料'}}</text>
        <text class="description">选择头像并填写昵称，保存后进入用户界面。</text>
      </view>
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" aria-label="选择微信头像">
        <image wx:if="{{form.avatarUrl}}" class="avatar" src="{{form.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder"><text class="avatar-plus">+</text><text>选择头像</text></view>
      </button>
      <text class="avatar-hint">{{isSavingAvatar ? '正在保存头像…' : '可从微信头像中选择，也可以使用新头像'}}</text>
      <view class="field">
        <text class="field-label">昵称</text>
        <input class="nickname-input" type="nickname" value="{{form.nickName}}" maxlength="24" placeholder="请输入昵称" bindinput="changeNickName" />
      </view>
      <text wx:if="{{errorMessage}}" class="error-message" role="alert">{{errorMessage}}</text>
      <button class="primary-button" disabled="{{isSavingAvatar}}" bindtap="submitProfile">保存并进入</button>
      <button wx:if="{{userProfile}}" class="secondary-button" bindtap="cancelEdit">取消</button>
    </view>

    <view wx:else class="home-panel">
      <view class="layout-spacer layout-spacer-top" aria-hidden="true"></view>
      <view class="user-card">
        <!-- 后续 UFO 插画替换位 -->
        <view class="art-placeholder ufo-placeholder" aria-hidden="true"></view>
        <view class="user-row">
          <image class="home-avatar" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
          <view class="user-copy">
            <text class="welcome">{{userProfile.nickName}}</text>
            <view class="profile-meta">
              <text class="profile-meta-item">基础资料</text>
              <text class="profile-meta-item profile-meta-item-accent">已完成</text>
            </view>
          </view>
          <button class="edit-button" bindtap="editProfile">编辑资料</button>
        </view>
        <view class="body-profile-tip" role="button" bindtap="openBodyProfile">
          <view class="body-profile-copy">
            <text class="body-profile-title">身体信息尚未完善</text>
            <text class="body-profile-description">填写后可查看体重、目标与运动频率</text>
          </view>
          <text class="continue-link">继续填写</text>
        </view>
        <!-- 后续小雪纳瑞插画替换位 -->
        <view class="art-placeholder dog-placeholder" aria-hidden="true"></view>
      </view>

      <view class="layout-spacer layout-spacer-profile-progress" aria-hidden="true"></view>
      <view class="progress-card">
        <view class="progress-heading">
          <text class="section-title">成长趋势</text>
          <text class="progress-days">累计天数 <text class="progress-days-value">— 天</text></text>
        </view>
        <view class="progress-label-row"><text>当前进度</text><text class="progress-value">—</text></view>
        <view class="progress-track"><view class="progress-fill"></view></view>
        <view class="data-block-list">
          <view class="data-block"><view class="data-placeholder"></view></view>
          <view class="data-block"><view class="data-placeholder"></view></view>
          <view class="data-block"><view class="data-placeholder"></view></view>
        </view>
        <view class="achievement-area">
          <text class="achievement-title">我的成就</text>
          <view class="achievement-list">
            <view class="achievement-item"><!-- 后续成就图标替换位 --><view class="achievement-placeholder"></view><text>连续7天</text></view>
            <view class="achievement-item"><!-- 后续成就图标替换位 --><view class="achievement-placeholder"></view><text>完成10次运动</text></view>
            <view class="achievement-item"><!-- 后续成就图标替换位 --><view class="achievement-placeholder"></view><text>早睡一周</text></view>
          </view>
        </view>
      </view>

      <view class="layout-spacer layout-spacer-progress-entry" aria-hidden="true"></view>
      <view class="entry-list">
        <view class="menu-card menu-card-single"><view class="menu-item"><view class="entry-icon-placeholder art-placeholder" aria-hidden="true"></view><text class="menu-title">我的画像</text><text class="menu-arrow">›</text></view></view>
        <view class="menu-card menu-card-single"><view class="menu-item"><view class="entry-icon-placeholder art-placeholder" aria-hidden="true"></view><text class="menu-title">我的方案</text><text class="menu-arrow">›</text></view></view>
        <view class="menu-card menu-card-single settings-card"><view class="menu-item"><view class="entry-icon-placeholder art-placeholder" aria-hidden="true"></view><text class="menu-title">设置与隐私</text><text class="menu-arrow">›</text></view></view>
      </view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{userProfile && !isEditing && !isLoading}}" class="bottom-navigation">
  <view class="bottom-navigation-item"><view class="nav-icon-placeholder art-placeholder"></view><text>FIFI</text></view>
  <view class="bottom-navigation-item"><view class="nav-icon-placeholder art-placeholder"></view><text>培养</text></view>
  <view class="bottom-navigation-item"><!-- 后续社区图标替换位 --><view class="nav-icon-placeholder art-placeholder"></view><text>社区</text></view>
  <view class="bottom-navigation-item bottom-navigation-item-active"><view class="nav-icon-placeholder art-placeholder"></view><text>我的</text></view>
</view>
