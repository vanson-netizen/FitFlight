<!-- index.wxml -->
<navigation-bar main-page="{{true}}" back="{{false}}" color="#25352b" background="#dff3b7"></navigation-bar>

<scroll-view class="scrollarea" scroll-y="{{true}}" enhanced="{{true}}" type="list">
  <view class="page page-content">
    <view wx:if="{{isLoading}}" class="state-panel">
      <view class="loading-dot"></view>
      <text>正在读取用户资料</text>
    </view>

    <view wx:elif="{{isEditing}}" class="profile-card edit-profile-card">
      <view class="card-heading">
        <text class="eyebrow">欢迎使用 FitFlight</text>
        <text class="title">{{userProfile ? '重新设置资料' : '登记你的资料'}}</text>
        <text class="description">选择头像并填写昵称，保存后进入用户界面。</text>
      </view>
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" aria-label="选择微信头像">
        <image wx:if="{{form.avatarUrl}}" class="avatar" src="{{form.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder"><text class="avatar-plus">+</text><text>选择头像</text></view>
      </button>
      <text class="avatar-hint">{{isSavingAvatar ? '正在保存头像…' : '可从微信头像中选择，也可以使用新头像'}}</text>
      <view class="field">
        <text class="field-label">昵称</text>
        <input class="nickname-input" type="nickname" value="{{form.nickName}}" maxlength="24" placeholder="请输入昵称" bindinput="changeNickName" />
      </view>
      <text wx:if="{{errorMessage}}" class="error-message" role="alert">{{errorMessage}}</text>
      <button class="primary-button" disabled="{{isSavingAvatar}}" bindtap="submitProfile">保存并进入</button>
      <button wx:if="{{userProfile}}" class="secondary-button" bindtap="cancelEdit">取消</button>
    </view>

    <view wx:else class="home-panel">
      <view class="layout-spacer layout-spacer-top" aria-hidden="true"></view>
      <view class="user-card">
        <!-- 后续 UFO 插画替换位 -->
        <view class="art-placeholder ufo-placeholder" aria-hidden="true"></view>
        <view class="user-row">
          <image class="home-avatar" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
          <view class="user-copy">
            <text class="welcome">{{userProfile.nickName}}</text>
            <view class="profile-meta">
              <text class="profile-meta-item">基础资料</text>
              <text class="profile-meta-item profile-meta-item-accent">已完成</text>
            </view>
          </view>
          <button class="edit-button" bindtap="editProfile">编辑资料</button>
        </view>
        <view wx:if="{{profileStatus === 'loading'}}" class="body-profile-tip body-profile-state">
          <view class="body-profile-loading-dot"></view>
          <text class="body-profile-description">正在读取身体档案…</text>
        </view>
        <view wx:elif="{{profileStatus === 'error'}}" class="body-profile-tip body-profile-state">
          <view class="body-profile-copy">
            <text class="body-profile-title">身体档案读取失败</text>
            <text class="body-profile-description">{{bodyProfileErrorMessage}}</text>
          </view>
          <button class="body-profile-action" bindtap="retryBodyProfile">重试</button>
        </view>
        <view wx:elif="{{profileStatus === 'incomplete'}}" class="body-profile-tip" role="button" bindtap="openBodyProfile">
          <view class="body-profile-copy">
            <text class="body-profile-title">身体信息尚未完善</text>
            <text class="body-profile-description">填写后可用于生成个性化培养方案</text>
          </view>
          <text class="continue-link">继续填写</text>
        </view>
        <view wx:else class="body-profile-motivation">
          <text class="body-profile-complete-label">身体档案已完成</text>
          <text class="body-profile-motivation-text">每一次认真记录，都是向更好的自己靠近。</text>
        </view>
        <!-- 后续小雪纳瑞插画替换位 -->
        <view class="art-placeholder dog-placeholder" aria-hidden="true"></view>
      </view>

      <view class="layout-spacer layout-spacer-profile-progress" aria-hidden="true"></view>
      <view class="progress-card">
        <view class="progress-heading">
          <text class="section-title">成长趋势</text>
          <text wx:if="{{growthStatus === 'ready' || growthStatus === 'empty'}}" class="progress-days">累计培养 <text class="progress-days-value">{{growthModel.cultivationDays}} 天</text></text>
        </view>
        <view wx:if="{{growthStatus === 'loading'}}" class="growth-state">
          <view class="body-profile-loading-dot"></view><text>正在读取成长记录…</text>
        </view>
        <view wx:elif="{{growthStatus === 'error'}}" class="growth-state growth-state-error">
          <text>{{growthErrorMessage}}</text><button class="growth-retry" bindtap="retryGrowth">重试</button>
        </view>
        <block wx:elif="{{growthStatus === 'ready' || growthStatus === 'empty'}}">
          <view class="growth-stat-list">
            <view class="growth-stat"><text class="growth-stat-value">{{growthModel.cultivationDays}}</text><text>累计培养天数</text></view>
            <view class="growth-stat"><text class="growth-stat-value">{{growthModel.streak}}</text><text>当前连续天数</text></view>
            <view class="growth-stat"><text class="growth-stat-value">{{growthModel.currentWeek.completionPercent}}%</text><text>本周完成率</text></view>
          </view>
          <view class="achievement-area" role="button" aria-label="查看我的成就" bindtap="openAchievements">
            <text class="achievement-title">成就</text>
            <view class="achievement-summary">
              <view class="achievement-icons">
                <view wx:for="{{growthModel.homeAchievements}}" wx:key="key" class="achievement-icon-item">
                  <view class="achievement-icon" aria-hidden="true"><view class="achievement-check"></view></view>
                  <text wx:if="{{item.unlocked}}" class="achievement-name">{{item.name}}</text>
                </view>
              </view>
              <text wx:if="{{!growthModel.achievements.length}}" class="achievement-empty">完成培养任务即可解锁</text>
            </view>
            <text class="achievement-arrow">›</text>
          </view>
        </block>
      </view>

      <view class="layout-spacer layout-spacer-progress-entry" aria-hidden="true"></view>
      <view class="entry-list">
        <view class="menu-card menu-card-single" role="button" bindtap="openMyPortrait"><view class="menu-item"><image class="entry-icon" src="/assets/icons/profile.png" mode="aspectFit" aria-hidden="true"></image><text class="menu-title">我的画像</text><text class="menu-arrow">›</text></view></view>
        <view class="menu-card menu-card-single" role="button" bindtap="openMyPlan"><view class="menu-item"><image class="entry-icon" src="/assets/icons/plan.png" mode="aspectFit" aria-hidden="true"></image><text class="menu-title">我的方案</text><text class="menu-arrow">›</text></view></view>
        <view class="menu-card menu-card-single settings-card" role="button" bindtap="openSettings"><view class="menu-item"><image class="entry-icon" src="/assets/icons/settings-privacy.png" mode="aspectFit" aria-hidden="true"></image><text class="menu-title">设置与隐私</text><text class="menu-arrow">›</text></view></view>
      </view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{userProfile && !isEditing && !isLoading}}" class="bottom-navigation">
  <view class="bottom-navigation-item" role="button" bindtap="openFifi"><image class="nav-icon" src="/assets/icons/tab-fifi-inactive.png" mode="aspectFit"></image><text>FIFI</text></view>
  <view class="bottom-navigation-item" role="button" bindtap="openCultivation"><image class="nav-icon" src="/assets/icons/tab-cultivation-inactive.png" mode="aspectFit"></image><text>培养</text></view>
  <view class="bottom-navigation-item" role="button" bindtap="openCommunity"><image class="nav-icon" src="/assets/icons/tab-community-inactive.png" mode="aspectFit"></image><text>社区</text></view>
  <view class="bottom-navigation-item bottom-navigation-item-active"><image class="nav-icon" src="/assets/icons/tab-mine-active.png" mode="aspectFit"></image><text>我的</text></view>
</view>

<body-profile-onboarding
  visible="{{showBodyProfileOnboarding}}"
  primary-disabled="{{isOpeningBodyProfile}}"
  bindconfirm="openBodyProfile"
  binddismiss="dismissBodyProfileOnboarding"
></body-profile-onboarding>
