page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f7f7ef;
  color: #25352b;
}

.scrollarea {
  min-height: 0;
  flex: 1;
  overflow: hidden;
}

.page { padding: 36rpx 28rpx 24rpx; }
.notice, .card { display: block; margin-bottom: 22rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; line-height: 1.6; }
.notice { background: #eef7da; }
.question { display: block; font-weight: 600; margin-bottom: 18rpx; }
.option { display: flex; align-items: flex-start; gap: 12rpx; padding: 12rpx 0; }
.confirmation-card { margin-bottom: 0; }

.action-bar {
  flex: none;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(93, 121, 79, .12);
  background: rgba(247, 247, 239, .98);
  box-shadow: 0 -8rpx 24rpx rgba(72, 91, 61, .08);
}

.save { margin: 0; background: #dff3b7; color: #25352b; border-radius: 999rpx; font-weight: 600; }
